# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.cursor/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Google Ads API candidatura (local only)
/docs/ProfitPilot-Google-Ads-API-Design-Document.md
/docs/ProfitPilot-Google-Ads-API-Design-Document.pdf
/scripts/md-to-pdf.py

# Scripts de diagnóstico / one-off (podem expor lojas, IDs, dados reais)
/scripts/diag-*.{ts,mjs,js}
/scripts/debug-*.{ts,mjs,js}
/scripts/check-*.{ts,mjs,js}
/scripts/probe-*.{ts,mjs,js}
/scripts/verify-*.{ts,mjs,js}
/scripts/raw-*.{ts,mjs,js}
/scripts/compare-*.{ts,mjs,js}
/scripts/investigate-*.{ts,mjs,js}
/scripts/purge-*.{ts,mjs,js}
/scripts/cleanup-*.{ts,mjs,js}
/scripts/list-*.{ts,mjs,js}
/scripts/seed-*.{ts,mjs,js}
/scripts/expand-*.{ts,mjs,js}
/scripts/refresh-*.{ts,mjs,js}
/scripts/relink-*.{ts,mjs,js}
/scripts/restore-*.{ts,mjs,js}
/scripts/fix-*.{ts,mjs,js}
/scripts/test-add-*.{ts,mjs,js}
/scripts/inspect-*.{ts,mjs,js}
/scripts/soft-delete-*.{ts,mjs,js}
/scripts/clear-*.{ts,mjs,js}

# Prints, screenshots e dumps locais
/prints/
/screenshots/
**/print*.png
**/print*.jpg
**/print*.jpeg
**/print*.webp
**/screenshot*.png
**/screenshot*.jpg
**/screenshot*.jpeg
**/screenshot*.webp

