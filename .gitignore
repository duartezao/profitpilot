# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.cursor/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Google Ads API candidatura (local only)
/docs/ProfitPilot-Google-Ads-API-Design-Document.md
/docs/ProfitPilot-Google-Ads-API-Design-Document.pdf
/scripts/md-to-pdf.py

# Scripts de diagnóstico / one-off (podem expor lojas, IDs, dados reais)
/scripts/diag-*.ts
/scripts/debug-*.ts
/scripts/check-*.ts
/scripts/probe-*.ts
/scripts/verify-*.ts
/scripts/raw-*.ts
/scripts/compare-*.ts
/scripts/investigate-*.ts

# Prints, screenshots e dumps locais
/prints/
/screenshots/
**/print*.png
**/print*.jpg
**/print*.jpeg
**/print*.webp
**/screenshot*.png
**/screenshot*.jpg
**/screenshot*.jpeg
**/screenshot*.webp

# Ficheiros temporários de teste
/tmp*
tmp-*
*.tmp.xlsx
*-test.xlsx
*-export-test.xlsx
